{
  "name": "aquastock-pro",
  "version": "3.4.7",
  "description": "Aquastock Pro — sistem manajemen stok peralatan aquarium (static frontend, siap dihubungkan ke backend)",
  "private": true,
  "scripts": {
    "build": "echo 'AquaStock Pro static assets ready'",
    "start": "npx serve public",
    "dev": "npx serve public --listen 8000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-size.js",
    "bump": "node scripts/bump-version.mjs",
    "build:css": "tailwindcss -i tailwind/input.css -o public/assets/css/tailwind.static.css --minify"
  },
  "keywords": [
    "aquarium",
    "inventory",
    "stock",
    "aquastock"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^21.0.1",
    "playwright": "^1.64.0",
    "serve": "^14.0.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.11"
  }
}
